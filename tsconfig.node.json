{
  "extends": "./tsconfig.base.json",
  "include": [
    "electron.vite.config.ts",
    "vitest.config.ts",
    "src/main/**/*",
    "src/core/**/*",
    "src/shared/**/*",
    "tests/unit/**/*",
    "tests/integration/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "outDir": "node_modules/.tmp/tsc-node",
    "types": [
      "node"
    ],
    "lib": [
      "ES2022"
    ],
    "baseUrl": ".",
    "paths": {
      "@shared/*": [
        "src/shared/*"
      ],
      "@core/*": [
        "src/core/*"
      ]
    }
  }
}
