{
  "name": "cartograph",
  "productName": "Cartograph",
  "version": "0.1.0",
  "description": "Cartograph — an AI-powered visual codebase editor. Import a codebase, see its architecture as an editable module graph, change the graph, and regenerate the source code to match.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "start:two": "npm run build && node scripts/launch-two.mjs",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.test-ui.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke-launch.mjs",
    "demo:setup": "node scripts/collab-demo.mjs",
    "demo:alice": "node scripts/launch-profile.mjs alice",
    "demo:bob": "node scripts/launch-profile.mjs bob",
    "verify": "npm run typecheck && npm run test && npm run build && npm run smoke"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@xyflow/react": "^12.8.6",
    "diff": "^8.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tree-sitter-wasm": "^2.0.4",
    "ts-morph": "^27.0.0",
    "typescript": "^5.9.3",
    "web-tree-sitter": "^0.27.1",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.18.9",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^38.2.2",
    "electron-vite": "^4.0.1",
    "jsdom": "^27.4.0",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  }
}
